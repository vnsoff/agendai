{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "regions": ["gru1"],
    "installCommand": "echo 'Dependencies are installed in CI (.github/workflows/tests.yml)'",
    "buildCommand": "echo 'Frontend is built in CI (.github/workflows/tests.yml)'",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "excludeFiles": "{node_modules/**,tests/**,docs/**,docker/**,storage/**,resources/js/**,resources/css/**,.github/**}"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "headers": {
                "cache-control": "public, max-age=31536000, immutable"
            },
            "continue": true
        },
        {
            "src": "/index\\.php",
            "dest": "/api/index.php"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
